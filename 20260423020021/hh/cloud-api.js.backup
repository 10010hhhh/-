/**
 * CloudBase API 模块 - 与云端数据库同步
 */

// 云函数 HTTP 访问地址
const CLOUD_API_URL = 'https://ai-native-d0gc0n8ngab6ad9a9-1424489190.ap-shanghai.app.tcloudbase.com/site-api';

// 云端数据缓存
let cloudData = null;
let isInitialized = false;
let initPromise = null;

/**
 * 初始化云端连接
 */
async function initCloud() {
    if (isInitialized) return cloudData;
    if (initPromise) return initPromise;
    
    initPromise = (async () => {
        try {
            console.log('[CloudAPI] Connecting to cloud...');
            const response = await fetch(CLOUD_API_URL, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ action: 'get' })
            });
            
            if (response.ok) {
                const result = await response.json();
                if (result.success) {
                    cloudData = result.data;
                    isInitialized = true;
                    console.log('[CloudAPI] Cloud connected successfully');
                    console.log('[CloudAPI] Data loaded:', Object.keys(cloudData));
                } else {
                    console.error('[CloudAPI] Cloud returned error:', result.error);
                }
            } else {
                console.error('[CloudAPI] Cloud request failed:', response.status);
            }
        } catch (error) {
            console.error('[CloudAPI] Cloud connection failed:', error.message);
        }
        return cloudData;
    })();
    
    return initPromise;
}

/**
 * 获取云端数据
 */
async function getCloudData() {
    if (!isInitialized) {
        await initCloud();
    }
    return cloudData;
}

/**
 * 保存数据到云端
 */
async function saveToCloud(key, value) {
    // 先确保已初始化
    if (!isInitialized) {
        await initCloud();
    }
    
    try {
        console.log('[CloudAPI] Saving to cloud:', key);
        const response = await fetch(CLOUD_API_URL, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'set', key, value })
        });
        
        if (response.ok) {
            const result = await response.json();
            if (result.success) {
                // 更新本地缓存
                if (cloudData) {
                    cloudData[key] = value;
                }
                console.log('[CloudAPI] Saved to cloud:', key);
                return true;
            } else {
                console.error('[CloudAPI] Save failed:', result.error);
            }
        } else {
            console.error('[CloudAPI] Save request failed:', response.status);
        }
    } catch (error) {
        console.error('[CloudAPI] Save error:', error.message);
    }
    return false;
}

/**
 * 强制从云端重新拉取数据（绕过缓存）
 */
async function forceRefreshCloudData() {
    try {
        console.log('[CloudAPI] Force refreshing cloud data...');
        const response = await fetch(CLOUD_API_URL, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'get' })
        });
        
        if (response.ok) {
            const result = await response.json();
            if (result.success) {
                cloudData = result.data;
                isInitialized = true;
                console.log('[CloudAPI] Cloud data refreshed:', Object.keys(cloudData || {}));
                return cloudData;
            } else {
                console.error('[CloudAPI] Force refresh returned error:', result.error);
            }
        } else {
            console.error('[CloudAPI] Force refresh request failed:', response.status);
        }
    } catch (error) {
        console.error('[CloudAPI] Force refresh failed:', error.message);
    }
    return cloudData;
}

// 暴露全局方法
window.CloudAPI = {
    init: initCloud,
    getData: getCloudData,
    save: saveToCloud,
    isReady: () => isInitialized,
    forceRefresh: forceRefreshCloudData
};
